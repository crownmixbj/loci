{
  "name": "parcel_mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~56.0.24",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "56",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit --noUnusedLocals",
    "verify:email": "npx esbuild scripts/verify-application-email.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-email.cjs --log-level=warning && node node_modules/.cache/verify-email.cjs",
    "verify:hubs": "npx esbuild scripts/verify-hubs.ts --bundle --platform=node --format=cjs --alias:@=./src --alias:react-native=./scripts/stubs/react-native.js --alias:@react-native-async-storage/async-storage=./scripts/stubs/async-storage.js --alias:react-native-svg=./scripts/stubs/empty.js --alias:expo-linear-gradient=./scripts/stubs/empty.js --alias:react-native-webview=./scripts/stubs/empty.js --alias:expo-router=./scripts/stubs/empty.js --outfile=node_modules/.cache/verify-hubs.cjs --log-level=warning && node node_modules/.cache/verify-hubs.cjs",
    "verify:drivers": "npx esbuild scripts/verify-driver-hub.ts --bundle --platform=node --format=cjs --alias:@=./src --alias:react-native=./scripts/stubs/react-native.js --alias:@react-native-async-storage/async-storage=./scripts/stubs/async-storage.js --outfile=node_modules/.cache/verify-drivers.cjs --log-level=warning && node node_modules/.cache/verify-drivers.cjs",
    "verify": "npm run verify:email && npm run verify:hubs && npm run verify:drivers && npm run verify:about && npm run verify:shipments && npm run verify:admin && npm run verify:session && npm run verify:experience && npm run typecheck",
    "verify:about": "npx esbuild scripts/verify-about.ts --bundle --platform=node --format=cjs --alias:@=./src --alias:react-native=./scripts/stubs/react-native.js --alias:@react-native-async-storage/async-storage=./scripts/stubs/async-storage.js --outfile=node_modules/.cache/verify-about.cjs --log-level=warning && node node_modules/.cache/verify-about.cjs",
    "verify:shipments": "npx esbuild scripts/verify-shipments.ts --bundle --platform=node --format=cjs --alias:@=./src --alias:react-native=./scripts/stubs/react-native.js --alias:@react-native-async-storage/async-storage=./scripts/stubs/async-storage.js --alias:react-native-svg=./scripts/stubs/empty.js --alias:expo-linear-gradient=./scripts/stubs/empty.js --alias:react-native-webview=./scripts/stubs/empty.js --alias:expo-router=./scripts/stubs/empty.js --outfile=node_modules/.cache/verify-shipments.cjs --log-level=warning && node node_modules/.cache/verify-shipments.cjs",
    "verify:admin": "npx esbuild scripts/verify-admin.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-admin.cjs --log-level=warning && node node_modules/.cache/verify-admin.cjs",
    "verify:session": "npx esbuild scripts/verify-session.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-session.cjs --log-level=warning && node node_modules/.cache/verify-session.cjs",
    "verify:experience": "npx esbuild scripts/verify-experience.ts --bundle --platform=node --format=cjs --alias:@=./src --alias:react-native=./scripts/stubs/react-native.js --outfile=node_modules/.cache/verify-experience.cjs --log-level=warning && node node_modules/.cache/verify-experience.cjs"
  },
  "private": true
}
